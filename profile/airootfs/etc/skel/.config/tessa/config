# Tessa compositor defaults for the installed desktop.
# Panel settings live in panel.conf.
terminal = kitty
kb_layout = jp
panel = true
xwayland = true
xim = true
xim_server = fcitx
startup = fcitx5 -d
theme = /usr/share/tessa/themes/vermilion-ink
animations = true
blur = true
shadows = true
corner_radius = 10
